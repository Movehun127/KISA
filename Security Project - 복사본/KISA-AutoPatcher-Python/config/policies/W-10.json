{
    "Title": "마지막 사용자 이름 표시 안 함",
    "Category": "계정 관리",
    "Level": "상",
    "TechType": "Type_Powershell",
    "CheckCommand": "$val = (Get-ItemProperty -Path 'HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' -Name DontDisplayLastUserName -ErrorAction SilentlyContinue).DontDisplayLastUserName\nif ($null -eq $val) { '0' } else { $val.ToString() }",
    "RemediationCommand": "Set-ItemProperty -Path 'HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' -Name DontDisplayLastUserName -Value 1",
    "SecureValue": "1",
    "ItemId": "W-10",
    "appTarget": "secpol.msc",
    "treePath": [
        [
            "보안 설정",
            "Security Settings"
        ],
        [
            "로컬 정책",
            "Local Policies"
        ],
        [
            "보안 옵션",
            "Security Options"
        ]
    ],
    "targetItem": [
        "대화형 로그온: 마지막 로그인 사용자 이름 표시 안 함",
        "Interactive logon: Do not display last user name"
    ]
}